{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path alias
       `@/*` 指向 shared/ —— 第 11 步（报告 3.5）把纯逻辑层从 src/ 迁到 shared/，
       原 alias 指向 src/* 会让 tests/ 的 8 个 import 全部失效。
       现在 @/types 与 @/utils/* 指向的仍是同一批文件，测试代码零改动。 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["shared/*"]
    }
  },
  "include": ["shared/**/*.ts", "tools/**/*.ts", "tests/**/*.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
