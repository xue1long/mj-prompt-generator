# 构建期提示词分解用的 LLM 代理（OpenAI 兼容协议，见 ADR-0015）
# 用法：复制本文件为 .env，填真实值。.env 已被 .gitignore 忽略，绝不提交。
# 工具：npm run decompose:explore

# 代理根地址。工具会拼上 /chat/completions；填到 /v1 即可。
MJ_DECOMPOSE_BASE_URL=http://127.0.0.1:3000/v1

# API Key
MJ_DECOMPOSE_API_KEY=sk-replace-with-your-key

# 模型名：请用强模型（Opus / Sonnet 级），分解质量才对齐 mj-prompt-decompose 技能
MJ_DECOMPOSE_MODEL=replace-with-your-strong-model

# 可选：并发数（默认 3，强模型限流时调小），单条超时毫秒（默认 90000）
# MJ_DECOMPOSE_CONCURRENCY=3
# MJ_DECOMPOSE_TIMEOUT_MS=90000
