{
  "name": "mj-prompt-generator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-webui.mjs",
    "build": "node scripts/build-webui.mjs",
    "preview": "node scripts/serve-webui.mjs --dist",
    "build:webui-data": "node scripts/build-webui-data.mjs --images=public",
    "legacy:dev": "vite",
    "legacy:build": "vue-tsc && vite build",
    "legacy:preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:vocab": "node tools/export-vocab.ts",
    "build:styles": "node tools/build-styles.ts",
    "collect:explore": "node tools/collect-explore.ts",
    "decompose:explore": "node tools/decompose-explore.ts",
    "update:explore": "node scripts/update-explore.mjs",
    "update:explore:no-decompose": "node scripts/update-explore.mjs --skip-decompose",
    "update:explore:collect-only": "node scripts/update-explore.mjs --collect-only",
    "sync:style-images": "node tools/sync-style-images.ts",
    "build:styles-top": "node tools/build-styles-top.ts",
    "sync:styles-top-images": "node tools/sync-styles-top-images.ts",
    "collect:styles-top": "node tools/collect-styles-top.ts",
    "update:styles-top": "npm run collect:styles-top && npm run build:styles-top && npm run build:webui-data && npm run build",
    "verify": "node scripts/verify-webui.mjs",
    "verify:dev": "node scripts/verify-webui.mjs",
    "verify:legacy": "node scripts/verify-app.mjs",
    "verify:legacy:dev": "node scripts/verify-app.mjs --require-dev"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "naive-ui": "^2.40.0",
    "pinia": "^2.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-vue": "^5.0.0",
    "puppeteer-core": "^24.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.0.0"
  }
}
